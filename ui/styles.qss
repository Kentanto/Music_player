/* Main Window */
QMainWindow {
    background-color: #1e1e1e;
    color: #ffffff;
}

QWidget {
    background-color: #1e1e1e;
    color: #ffffff;
}

/* Buttons */
QPushButton {
    background-color: #282828;
    color: #ffffff;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 8px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1db954;
    border: 1px solid #1ed760;
}

QPushButton#shuffleButton {
    background-color: #282828;
    border: 1px solid #404040;
}

QPushButton#shuffleButton:hover {
    background-color: #404040;
    border: 1px solid #707070;
}

QPushButton#shuffleButton:checked {
    background-color: #1db954;
    border: 1px solid #1ed760;
}

QPushButton#shuffleButton:checked:hover {
    background-color: #75d99a;
    color: #121212;
    border: 1px solid #a1ebbb;
}

QPushButton:pressed {
    background-color: #1aa34a;
}

QPushButton[remoteHighlight="true"], QLineEdit[remoteHighlight="true"],
QSlider[remoteHighlight="true"], QListWidget[remoteHighlight="true"] {
    border: 2px solid #1ed760;
}

QListWidget[remoteHighlight="true"] {
    background-color: #1b2a20;
}

/* Search Bar */
QLineEdit {
    background-color: #1e1e1e;
    color: #ffffff;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 8px;
    selection-background-color: #1db954;
}

QLineEdit:focus {
    border: 2px solid #1db954;
}

/* List Widget */
QListWidget {
    background-color: #121212;
    color: #ffffff;
    border: 1px solid #404040;
    border-radius: 4px;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #282828;
}

QListWidget::item:selected {
    background-color: #1db954;
}

QListWidget::item:hover {
    background-color: #282828;
}

/* Sliders */
QSlider::groove:horizontal {
    background-color: #282828;
    border-radius: 4px;
    height: 8px;
}

QSlider::handle:horizontal {
    background-color: #1db954;
    border: 1px solid #1ed760;
    width: 14px;
    margin: -3px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #1ed760;
}

/* Labels */
QLabel {
    color: #ffffff;
}

/* Splitter */
QSplitter::handle {
    background-color: #282828;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #121212;
    width: 12px;
}

QScrollBar::handle:vertical {
    background-color: #404040;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #1db954;
}

/* Fullscreen player */
QWidget#fullscreenInfoPanel {
    background-color: transparent;
    border: none;
}

QWidget#fullscreenEQOverlay,
QWidget#fullscreenTimestampRow,
QWidget#fullscreenInfoPanel QWidget {
    background-color: transparent;
}

QLabel#fullscreenTitle {
    color: #ffffff;
    background-color: transparent;
    font-size: 24px;
    font-weight: bold;
}

QLabel#fullscreenArtist {
    color: #a7a7a7;
    background-color: transparent;
}

QLabel#fullscreenVolumeLabel {
    color: #a7a7a7;
}

QLabel#fullscreenNormalTime {
    background-color: #169c46;
    color: #d0d0d0;
    font-size: 12px;
    font-weight: bold;
}

QWidget#fullscreenEQProgressBadge {
    background-color: #169c46;
    border: none;
}

QPushButton#fullscreenControl, QPushButton#fullscreenPlayControl {
    min-width: 58px;
    max-width: 58px;
    min-height: 42px;
    max-height: 42px;
    padding: 0;
    border: 1px solid #505050;
    border-radius: 21px;
    background-color: #252525;
    color: #f2f2f2;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#fullscreenControl:hover {
    background-color: #383838;
    border-color: #7a7a7a;
}

QPushButton#fullscreenControl:pressed {
    background-color: #1b1b1b;
    border-color: #1db954;
}

QPushButton#fullscreenPlayControl {
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
    border-radius: 28px;
    background-color: #1db954;
    color: #101010;
    border-color: #1ed760;
    font-size: 18px;
}

QPushButton#fullscreenPlayControl:hover {
    background-color: #35c96a;
    border-color: #75e39a;
}

QPushButton#fullscreenPlayControl:pressed {
    background-color: #169c46;
    border-color: #1ed760;
}

QLabel#fullscreenVolumeLabel {
    color: #c4c4c4;
    font-size: 12px;
    font-weight: bold;
}

QWidget#fullscreenVolumeControl {
    background-color: #1e1e1e;
    border-radius: 16px;
}

QSlider#fullscreenSeek, QSlider#fullscreenEQSeek {
    min-width: 260px;
    background-color: transparent;
}

QSlider#fullscreenSeek::groove:horizontal,
QSlider#fullscreenEQSeek::groove:horizontal {
    background-color: #505050;
    height: 6px;
    border-radius: 3px;
}

QSlider#fullscreenEQSeek::groove:horizontal {
    background-color: transparent;
    height: 2px;
}

QSlider#fullscreenSeek::sub-page:horizontal {
    background-color: #1db954;
    border-radius: 3px;
}

QSlider#fullscreenSeek::handle:horizontal {
    background-color: #1db954;
    border: 1px solid #1ed760;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider#fullscreenEQSeek::sub-page:horizontal,
QSlider#fullscreenEQSeek::handle:horizontal {
    background-color: transparent;
    border: none;
    width: 1px;
    height: 1px;
    margin: 0;
}

QSlider#fullscreenVolume {
    min-width: 120px;
    max-width: 120px;
}
